# Variables de entorno para produccion
# Copia este archivo como .env.prod y completa los valores
# Ejecutar con: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# MongoDB (OBLIGATORIOS en produccion)
MONGO_USERNAME=admin
MONGO_PASSWORD=tu-password-seguro-aqui-minimo-12

# JWT (OBLIGATORIO - minimo 32 caracteres)
JWT_SECRET=tu-secreto-super-seguro-aqui-minimo-32-caracteres
JWT_EXPIRATION_MS=604800000

# OpenAI
OPENAI_API_KEY=sk-tu-api-key-de-openai

# Origenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Credenciales del admin seed (OBLIGATORIAS - sin default en produccion)
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=tu-password-de-admin-aqui-minimo-12
