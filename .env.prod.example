# Variables de entorno para produccion en Railway
# Copia este archivo como .env.prod y completa los valores

# MongoDB (Railway proporciona MONGO_URL automaticamente)
MONGODB_URI=

# JWT
JWT_SECRET=tu-secreto-super-seguro-aqui-cambiar-en-produccion
JWT_EXPIRATION_MS=604800000

# OpenAI
OPENAI_API_KEY=sk-tu-api-key-de-openai

# Frontend URL (cambiar por tu URL de Railway)
FRONTEND_URL=https://tu-proyecto.up.railway.app

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
