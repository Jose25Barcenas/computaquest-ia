# Variables de entorno para produccion
# Copia este archivo como .env.prod y completa los valores

# MongoDB
MONGO_USERNAME=admin
MONGO_PASSWORD=tu-password-seguro-aqui

# JWT (requerido - sin valor por defecto por seguridad)
JWT_SECRET=tu-secreto-super-seguro-aqui-minimo-32-caracteres
JWT_EXPIRATION_MS=604800000

# OpenAI
OPENAI_API_KEY=sk-tu-api-key-de-openai

# Frontend URL
FRONTEND_URL=https://tu-dominio.com

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Admin credentials (solo para desarrollo, no usar en produccion)
# ADMIN_EMAIL=admin@computaquest.com
# ADMIN_PASSWORD=changeme
