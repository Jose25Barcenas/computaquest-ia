# Backend
MONGODB_URI=mongodb://localhost:27017/computaquest
# Minimo 32 caracteres (si no, la app no arranca)
JWT_SECRET=dev-only-change-me-to-a-long-random-secret-32+
JWT_EXPIRATION_MS=604800000
OPENAI_API_KEY=sk-your-openai-api-key-here
# Origenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# URL publica del frontend (usada en el email de recuperacion de contrasena)
FRONTEND_URL=http://localhost:3000

# Recuperacion de contrasena por correo (opcional).
# Si SPRING_MAIL_HOST no esta definido, /api/auth/forgot-password responde 503.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu-usuario-smtp
SPRING_MAIL_PASSWORD=tu-password-smtp
MAIL_FROM=noreply@computaquest.app

# Rate limit: ponlo en true solo si hay un proxy (nginx/Railway) delante
TRUST_PROXY=false
