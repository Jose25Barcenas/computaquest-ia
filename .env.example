# Entorno para docker-compose.yml (desarrollo local)
# Copia este archivo como .env y completa los valores
# Ejecutar con: docker compose up --build

# OBLIGATORIO - minimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET=genera-aqui-un-secreto-de-al-menos-32-caracteres

OPENAI_API_KEY=

# Credenciales de MongoDB (opcionales en desarrollo)
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123
